oci_image(
    name = "image",
    architecture = "amd64",
    env = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"},
    labels = {
        "org.opencontainers.image.title": "space-rust-build-kind",
        "org.opencontainers.image.description": "SPACE Rust build artifacts for the local kind stack: the union of every production artifact set from one build.",
    },
    os = "linux",
    tars = [
        ":space-api-svc_layer",
        ":space-buildmgr_layer",
        ":space-buildmgr-svc_layer",
        ":space-cluster-controller_layer",
        ":space-credmgr-svc_layer",
        ":space-data-plane-svc_layer",
        ":space-db-migrator_layer",
        ":space-internal-api-svc_layer",
        ":space-mock-branching-key-provider-svc_layer",
        ":space-netgtw-svc_layer",
        ":space-node-api-svc_layer",
        ":space-nodectl_layer",
        ":space-nodectl-svc_layer",
        ":space-nodemgr-svc_layer",
        ":space-rtmgr_layer",
        ":space-rtmgr-svc_layer",
        ":space-runtime-supervisor-svc_layer",
        ":space-sbxmgr_layer",
        ":space-sbxmgr-svc_layer",
        ":space-spaced-host-svc_layer",
        ":space-template-publish_layer",
        ":space-tmplmgr_layer",
        ":space-tmplmgr-svc_layer",
        ":space-volmgr_layer",
        ":space-volmgr-svc_layer",
        ":spaced_layer",
        ":spaced-svc_layer",
        ":probe_layer",
        ":compatibility",
    ],
    workdir = "/",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["space-rust-build-kind:local"],
)

filegroup(
    name = "image_tarball",
    srcs = [":load"],
    output_group = "tarball",
    visibility = ["//visibility:public"],
)
