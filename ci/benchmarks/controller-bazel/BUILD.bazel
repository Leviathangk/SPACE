load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load(":layout.bzl", "oci_layout")
load(":variants.bzl", "supervisor_flag")

exports_files([
    "crates.bzl",
    "features.bzl",
    "features.MODULE.bazel",
    "patches/sqlite-build-script.patch",
    "patches/rules-rs-feature-profile.patch",
    "patches/llvm-resource-headers.patch",
])

alias(
    name = "controller",
    actual = "//crates/apps/cluster/controller/svc:svc",
)

genrule(
    name = "controller_binary",
    srcs = [":controller"],
    outs = ["space-cluster-controller"],
    cmd = 'cp "$(location :controller)" "$@"',
)

pkg_tar(
    name = "controller_layer",
    srcs = [":controller_binary"],
    mode = "0755",
    owner = "953.953",
    package_dir = "/space/bin",
)

genrule(
    name = "revision",
    srcs = ["//:.cache/controller-benchmark/revision.txt"],
    outs = ["build-git-sha"],
    cmd = 'cp "$(location //:.cache/controller-benchmark/revision.txt)" "$@"',
)

pkg_tar(
    name = "revision_layer",
    srcs = [":revision"],
    mode = "0644",
    package_dir = "/etc/space",
)

oci_layout(
    name = "runtime",
    archive = "//:.cache/controller-benchmark/runtime.oci.tar",
)

oci_image(
    name = "image",
    base = ":runtime",
    labels = "//:.cache/controller-benchmark/labels.txt",
    tars = [
        ":controller_layer",
        ":revision_layer",
    ],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["space-controller-bazel:benchmark"],
)

filegroup(
    name = "image_tarball",
    srcs = [":load"],
    output_group = "tarball",
)

config_setting(
    name = "exec_configuration",
    constraint_values = [":host_role"],
    visibility = ["//visibility:public"],
)

constraint_setting(
    name = "build_role",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "host_role",
    constraint_setting = ":build_role",
    visibility = ["//visibility:public"],
)

platform(
    name = "host_platform",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        ":host_role",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "target_platform",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

supervisor_flag(
    name = "supervisor_profile",
    build_setting_default = False,
)

config_setting(
    name = "supervisor_target_configuration",
    flag_values = {":supervisor_profile": "true"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "supervisor_exec_configuration",
    constraint_values = [":host_role"],
    flag_values = {":supervisor_profile": "true"},
    visibility = ["//visibility:public"],
)
