module(
    name = "space",
    version = "0.8.0",
)

bazel_dep(name = "rules_rs", version = "0.1.0")
single_version_override(
    module_name = "rules_rs",
    patch_strip = 1,
    patches = ["//ci/benchmarks/controller-bazel:patches/rules-rs-feature-profile.patch"],
)

bazel_dep(name = "llvm", version = "0.8.24")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "platforms", version = "1.1.0")

rust = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust.toolchain(
    edition = "2024",
    version = "1.98.0",
)
use_repo(rust, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...", "@llvm//toolchain:all")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:.cache/controller-benchmark/resolver/Cargo.lock",
    cargo_toml = "//:.cache/controller-benchmark/resolver/Cargo.toml",
    platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "crates")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "benchmark_protoc",
    build_file_content = """
exports_files(["bin/protoc"])
filegroup(name = "includes", srcs = glob(["include/**"]), visibility = ["//visibility:public"])
""",
    sha256 = "3a4c1e5f2516c639d3079b1586e703fc7bcfa2136d58bda24d1d54f949c315e8",
    urls = ["https://github.com/protocolbuffers/protobuf/releases/download/v21.12/protoc-21.12-linux-x86_64.zip"],
)

# The build-script executable must not embed a sandbox-specific source path.
crate.annotation(
    crate = "libsqlite3-sys",
    patch_args = ["-p1"],
    patches = ["//ci/benchmarks/controller-bazel:patches/sqlite-build-script.patch"],
)

include("//ci/benchmarks/controller-bazel:features.MODULE.bazel")

register_execution_platforms("//ci/benchmarks/controller-bazel:host_platform")

bazel_dep(name = "gazelle_rs", version = "1.2.1", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.51.3", dev_dependency = True)
bazel_dep(name = "rules_go", version = "0.62.0", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.download(version = "1.24.12")

rules_rust_prost = use_extension("@rules_rs//rs:rules_rust_prost.bzl", "rules_rust_prost")
use_repo(rules_rust_prost, "rules_rust_prost")

register_toolchains(
    "@rules_rust_prost//:default_prost_toolchain",
    dev_dependency = True,
)

bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_cc", version = "0.2.25")

single_version_override(
    module_name = "llvm",
    patch_strip = 1,
    patches = ["//ci/benchmarks/controller-bazel:patches/llvm-resource-headers.patch"],
)

include("//ci/benchmarks/kind-bazel:probe.MODULE.bazel")
